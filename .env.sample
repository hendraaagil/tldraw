# Cloudflare Tunnel token for the cloudflared service (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# tldraw license key (https://tldraw.dev) - baked in at build time.
# Without it the editor blanks out after 5s on any non-localhost host.
VITE_TLDRAW_LICENSE_KEY=

# Sync server WebSocket base URL, baked in at build time (no trailing slash).
# Set it to enable cross-device collaboration; leave empty for local-only.
# e.g. wss://sync.example.com  -> connects wss://sync.example.com/connect/<room>
VITE_SYNC_URI=

# Shared access token checked by the sync server. Set it to require a token on
# the client gate; leave empty to disable auth. Runtime env on the sync service
# (not baked into the client build).
SYNC_SECRET=

# Host directory for sync data (room snapshots + assets). Bind-mounted to /data
# in the sync container. Defaults to ./server/.data next to compose.yml.
SYNC_DATA_DIR=/mnt/data-drive/tldraw
